def _shift_char(ch, shift):
    """알파벳 한 글자를 shift만큼 역방향으로 이동한다.
 
    대문자/소문자를 유지하며, 알파벳이 아닌 문자는 그대로 반환한다.
 
    Args:
        ch    (str): 단일 문자
        shift (int): 이동할 자리수 (1 ~ 26)
 
    Returns:
        str: 복호화된 문자
    """
    if ch.isupper():
        return chr((ord(ch) - ord('A') - shift) % 26 + ord('A'))
    if ch.islower():
        return chr((ord(ch) - ord('a') - shift) % 26 + ord('a'))
    return ch
 
 
def _contains_dictionary_word(text, dictionary):
    """텍스트에 사전 단어가 포함되어 있으면 해당 단어를 반환한다.
 
    대소문자를 구분하지 않고 단어 단위로 비교한다.
 
    Args:
        text       (str):      검사할 텍스트
        dictionary (iterable): 단어 목록
 
    Returns:
        str | None: 발견된 사전 단어, 없으면 None
    """
    words_in_text = text.lower().split()
    for word in words_in_text:
        clean = word.strip(string.punctuation)
        if clean in dictionary:
            return clean
    return None
 
 
def caesar_cipher_decode(target_text, auto_detect=True):
    """카이사르 암호를 자리수 1 ~ 26으로 순차 복호화하여 결과를 출력한다.
 
    자리수(shift)를 1부터 26까지 바꾸어가며 복호화 결과를 출력하고,
    [보너스] auto_detect=True이면 사전 단어가 발견되는 즉시 탐색을 멈춘다.
 
    복호화 공식:
        plain_char = (cipher_char_index - shift) mod 26
 
    Args:
        target_text (str):  복호화할 암호문 문자열
        auto_detect (bool): True이면 사전 단어 발견 시 자동 종료 (보너스)
 
    Returns:
        dict[int, str]: {자리수: 복호화 결과} 전체 결과 딕셔너리
    """
    alphabet_size = 26
    results = {}
 
    print('=' * 60)
    print('  카이사르 암호 복호화 결과')
    print('=' * 60)
    print('  암호문 :', repr(target_text))
    if auto_detect:
        print('  자동감지: ON (사전 단어 발견 시 정지)')
    else:
        print('  자동감지: OFF')
    print('=' * 60)
    print('  {:>4}  {:<30}  {}'.format('자리수', '복호화 결과', '비고'))
    print('  ' + '-' * 56)
 
    for shift in range(1, alphabet_size + 1):
        decoded = ''.join(_shift_char(ch, shift) for ch in target_text)
        results[shift] = decoded
 
        found_word = None
        note = ''
        if auto_detect:
            found_word = _contains_dictionary_word(decoded, ENGLISH_DICTIONARY)
            if found_word:
                note = '★ 사전 단어 발견: "{}"'.format(found_word)
 
        print('  {:>4}번  {:<30}  {}'.format(shift, decoded, note))
 
        if found_word:
            print('  ' + '-' * 56)
            print('  → 자리수 {}에서 사전 단어 감지 — 탐색 중단'.format(shift))
            break
 
    print('=' * 60)
    return results
 
 
def save_result(shift, decoded_text, output_path='result.txt'):
    """지정한 자리수의 복호화 결과를 파일에 저장한다.
 
    Args:
        shift         (int): 사용한 자리수
        decoded_text  (str): 복호화된 텍스트
        output_path   (str): 저장할 파일 경로
 
    Returns:
        bool: 저장 성공 시 True, 실패 시 False
    """
    try:
        with open(output_path, 'w', encoding='utf-8') as f:
            f.write('자리수  : {}\n'.format(shift))
            f.write('복호화  : {}\n'.format(decoded_text))
        print('\n  [저장] {} 에 결과를 저장했습니다.'.format(output_path))
        return True
    except IOError as e:
        print('\n  [오류] 파일 저장 실패: {}'.format(e))
        return False
 
 
def load_password(file_path='password.txt'):
    """password.txt 파일에서 암호문을 읽어 반환한다.
 
    Args:
        file_path (str): 읽을 파일 경로
 
    Returns:
        str | None: 파일 내용 문자열, 실패 시 None
    """
    try:
        with open(file_path, 'r', encoding='utf-8') as f:
            content = f.read().strip()
        print('  [읽기] {} 로드 완료: {}'.format(file_path, repr(content)))
        return content
    except FileNotFoundError:
        print('  [오류] 파일을 찾을 수 없습니다: {}'.format(file_path))
        return None
    except IOError as e:
        print('  [오류] 파일 읽기 실패: {}'.format(e))
        return None
 
 
